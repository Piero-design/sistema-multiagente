# For the other computer (not executed on the development laptop). Copy to .env, then:
#   docker compose --profile ollama up --build -d
LLM_MODE=ollama
LLM_API_KEY=
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b            # supports tool-calling; confirm on that machine
LLM_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=300
LLM_MAX_CONCURRENCY=2

POSTGRES_USER=gestitel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gestitel
ORCHESTRATOR_DB_PASSWORD=change-me-too
FRONTEND_PORT=8080
