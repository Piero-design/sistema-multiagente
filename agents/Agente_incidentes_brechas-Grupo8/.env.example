# ── Proveedor LLM ──────────────────────────────────────────────────────────────
# Deje vacías las variables del proveedor que NO usa.
# El sistema detecta automáticamente cuál usar (Gemini o Groq primero; Claude si no hay ninguna).

# ── Opción A: Google Gemini (GRATIS) ───────────────────────────────────────────
# Obtén tu API key gratis en https://aistudio.google.com/apikey
# Límite gratuito: 1,500 req/día · 1M tokens/min · contexto 1M tokens.
GEMINI_API_KEY=

# ── Opción B: Groq (GRATIS) ────────────────────────────────────────────────────
# Obtén tu API key gratis en https://console.groq.com/keys
# Modelo: openai/gpt-oss-120b. Límite: 12k tokens/min (puede ralentizar el análisis).
GROQ_API_KEY=

# ── Opción C: Claude Code (suscripción) ────────────────────────────────────────
# Token de suscripción. Genera con: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# ── Opción D: Claude API key (pago por uso) ────────────────────────────────────
# Créala en https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Autonomía (buzón de quejas y conectores) ─────────────────────────────────
# Se configuran en config/conectores.json (ver config/README.md). Aquí solo van los secretos.
# Token que debe enviar el formulario de quejas en la cabecera X-Webhook-Token (vacío = webhook deshabilitado).
BUZON_WEBHOOK_TOKEN=
# 1 = arrancar con la autonomía activa (también se puede activar desde la interfaz).
AUTONOMIA=0
# Ejemplos de variables referenciadas desde conectores.json (usuario_env, clave_env, auth_env):
# QUEJAS_USER=
# QUEJAS_PASS=
# SIEM_TOKEN=
