# Copy to .env (git-ignored). Never commit real values.

# ---- Shared LLM gateway ----
LLM_MODE=cloud                 # cloud | ollama | mock
LLM_API_KEY=                   # shared key: ONLY used if LLM_ALLOW_SHARED_FALLBACK=true (development)
LLM_ALLOW_SHARED_FALLBACK=false
# One Gemini key PER TEAM (each team gets its own at https://aistudio.google.com/apikey).
# Each agent calls the gateway under its own prefix, so a team uses only its own quota.
LLM_API_KEY_G1=
LLM_API_KEY_G2=
LLM_API_KEY_G3=               # G3's MCP server does not use a model; slot kept for its assistant layer
LLM_API_KEY_G4=
LLM_API_KEY_G5=
LLM_API_KEY_G6=               # G6 is rule-based (no model); slot kept for consistency
LLM_API_KEY_G7=
LLM_API_KEY_G8=
# Optional per-team model override, e.g. LLM_MODEL_G5=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # cloud: OpenAI-compatible; ollama: leave empty
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBED_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=4

# ---- PostgreSQL (internal only) ----
POSTGRES_USER=gestitel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gestitel
ORCHESTRATOR_DB_PASSWORD=change-me-too

# ---- Platform ----
FRONTEND_PORT=8080

# ---- Human review page (/revision) ----
# Demo accounts "user:password:ROLE;..." with roles DPO and Legal. CHANGE THEM before showing this outside your machine.
HUMAN_USERS=dpo:demo-dpo:DPO;legal:demo-legal:Legal
HUMAN_SECRET=                  # optional: fixed signing secret (random per start if empty)
HUMAN_BRIDGE_TOKEN=bridge_dev_token

# ---- Team keys set from the web (/configuracion) ----
# The gateway only accepts key changes from the backend, using this token.
GATEWAY_ADMIN_TOKEN=change-me-long-random
# One access code per team. The administrator gives each team its code; empty = that team cannot set its key from the web.
TEAM_CODE_G1=
TEAM_CODE_G2=
TEAM_CODE_G3=
TEAM_CODE_G4=
TEAM_CODE_G5=
TEAM_CODE_G6=
TEAM_CODE_G7=
TEAM_CODE_G8=

# Token of the G8 complaints webhook (POST /api/buzon/webhook/quejas-web with header X-Webhook-Token). Empty = disabled.
G8_BUZON_TOKEN=
