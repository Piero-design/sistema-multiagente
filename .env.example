# Copy to .env (git-ignored). Never commit real values.

# ---- Shared LLM gateway ----
LLM_MODE=cloud                 # cloud | ollama | mock
LLM_API_KEY=                   # cloud only
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # cloud: OpenAI-compatible; ollama: leave empty
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBED_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=4

# ---- PostgreSQL (internal only) ----
POSTGRES_USER=gestitel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gestitel
ORCHESTRATOR_DB_PASSWORD=change-me-too

# ---- Platform ----
FRONTEND_PORT=8080

# ---- Human review page (/revision) ----
# Demo accounts "user:password:ROLE;..." with roles DPO and Legal. CHANGE THEM before showing this outside your machine.
HUMAN_USERS=dpo:demo-dpo:DPO;legal:demo-legal:Legal
HUMAN_SECRET=                  # optional: fixed signing secret (random per start if empty)
HUMAN_BRIDGE_TOKEN=bridge_dev_token
# ---- G3 (DSAR): mail intake and outbox (optional; defaults: mailbox folder in the volume, sending off) ----
# G3_MAIL_SOURCE=folder                # folder | imap
# G3_MAIL_IMAP_HOST=
# G3_MAIL_USER=
# G3_MAIL_PASSWORD=
# G3_MAIL_SMTP_HOST=
# G3_MAIL_ALLOWED_SENDERS=*@example.test
# G3_MAIL_SEND_ENABLED=false          # true only to really send, to allow-listed recipients
